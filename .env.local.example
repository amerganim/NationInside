# Copy to .env.local and fill from your Supabase project
# (Supabase dashboard → Project Settings → API)

# Public — safe to expose to the browser (protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — server-only. NEVER expose to the browser or commit to git.
# Used by server actions for admin operations (member approval, scoring, etc.)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
